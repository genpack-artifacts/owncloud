{
    include_commit_id: true,
    profile: "paravirt",
    packages: [
        "genpack/paravirt",

        "www-servers/apache",
        "dev-lang/php",
        "dev-php/PEAR-PEAR",  // pecl (50-php.sh が smbclient 拡張の導入に使う)
        "dev-php/pecl-apcu",
        "dev-php/pecl-redis",

        "dev-db/mysql",
        "mail-mta/postfix",
        "net-fs/samba",  // php の smbclient 拡張が使う
        "media-video/ffmpeg",
        "dev-db/redis",
        "net-analyzer/zabbix",
        "dev-util/trace-cmd",

        "net-vpn/frp",

        "dev-libs/nss",  // certutil (for trust-private-ca.py)

        "app-admin/sudo"  // owncloud ユーザーが occ を実行するため (sudoers.d/owncloud)
    ],
    buildtime_packages: [
        "dev-build/autoconf",  // needed by 50-php.sh (pecl install smbclient)
        "app-misc/jq",  // needed by 60-owncloud.sh (parse GitHub releases API)
    ],
    accept_keywords: {
        "net-vpn/frp": null,
    },
    use:{
        // ownCloud 11 は PHP 8.3〜8.5 必須。dev-lang/php の amd64 安定版は 8.3 で、
        // PHP_TARGETS のプロファイル既定値も php8-3 なので pecl 拡張もそのまま乗る。
        // mod_php(apache2 SAPI)ではなく fpm を選び、70_php_fpm.conf で proxy_fcgi 経由に
        // 繋いでいる。旧構成(Remi の php-fpm)と同形で apache 側の変更が最小になり、
        // apache の MPM 選択と PHP の ZTS 要否を切り離せる(nextcloud は mod_php を選んだ
        // 結果 pecl-imagick の ZTS 非対応に引きずられて prefork 固定になっている)。
        // 拡張は ownCloud のチェック(zip/dom/XMLWriter/XMLReader/intl/libxml/mbstring/
        // ctype/JSON/GD/zlib/iconv/SimpleXML/hash/cURL/PDO)を満たす構成。
        "dev-lang/php": "fpm -apache2 bcmath curl exif ftp gd gmp intl jpeg ldap mysql mysqli pcntl pdo png sharedmem sockets sodium sysvipc truetype webp xmlreader xmlwriter xslt zip -postgres -sqlite",
        "app-eselect/eselect-php": "fpm",
        "media-libs/freetype": "harfbuzz",
        "media-libs/gd": "truetype webp",
        // mod_php を使わず apache は静的ファイル配信と fcgi プロキシしかしないので、
        // 1接続1プロセスの prefork は無駄。event MPM(threaded)にする。PHP は php-fpm の
        // 別プロセスなので apache がスレッド化しても ZTS ビルドは不要。
        // APACHE2_MPMS 未指定だと apache-2.eclass が USE=threads の有無で決め打ちし、
        // threads が無いと prefork にフォールバックする(それが従来の姿だった)。
        // なお threaded MPM は REQUIRED_USE で threads を要求する。
        "www-servers/apache": "threads APACHE2_MODULES: http2 proxy proxy_connect proxy_http proxy_ajp proxy_fcgi remoteip APACHE2_MPMS: event",
        "net-analyzer/zabbix": "curl -frontend -mysql proxy -server snmp openipmi ssh libxml2 -postgres  sqlite",
        "net-analyzer/fping":"suid",
        "dev-libs/jemalloc": "stats",
        "net-libs/ngtcp2": "gnutls",
    },
    license:{
        "net-analyzer/fping":"fping",
        "dev-db/redis": "SSPL-1"
    },
    services:["apache2", "mysqld", "postfix", "redis"],

    // 運用用ログインユーザー (uid/gid 1000 = 先頭の一般ユーザー UID)。
    // SSH 鍵でログインし sudo で occ を叩くための入口。公開鍵の設置は本成果物外。
    groups: [
        { name: "owncloud", gid: 1000 },
    ],
    users: [
        {
            name: "owncloud",
            uid: 1000,
            home: "/home/owncloud",
            shell: "/bin/bash",
            initial_group: "owncloud",
            create_home: true,
        },
    ],

    variants: {
        "selftestable": {
            packages: [
                "dev-libs/weston-deferred",
                "www-client/google-chrome",
                "media-fonts/vlgothic",
            ],
            use: {
                // for weston
                "*/*": "-X wayland", 
                "sys-auth/seatd": "server",
                // for google-chrome
                "media-libs/libepoxy": "X",
                "x11-libs/gtk+": "X",
                "x11-libs/cairo": "X",
                "media-libs/libglvnd": "X",
                "app-text/xmlto": "text", 
            },
            license:{
                "www-client/google-chrome": "google-chrome"
            },
            services: ["weston","seatd"]
        }
    }
}
// vm run --hostfwd=tcp::3000-:80 owncloud-$(uname -m).squashfs
